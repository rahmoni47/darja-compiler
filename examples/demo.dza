// تجربة لغة الدارجة الجزائرية (DZA)
// أنواع البيانات: أعداد، نصوص، وقيم منطقية

كاش_كاين name, age, isStudent;
name = "Rahmoni";
age = 25;
isStudent = غلط;

وري("=== مرحبا بيك في لغة الدارجة ===");
وري("الإسم: " + name);
وري("العمر: " + age);

// شروط منطقية وعمليات حسابية
كاش_كاين isAdult;
isAdult = age >= 18;

وري("واش كبير؟");
وري(isAdult);

// حلقة تكرار بسيطة
كاش_كاين counter;
counter = 1;

وري("=== العد التنازلي ===");
مدام (counter <= 5) {
    وري(counter);
    counter = counter + 1;
}

وري("صحة خويا! كملنا البروجي بنجاح.");
